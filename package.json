{
    "private": true,
    "packageManager": "pnpm@9.15.0",
    "scripts": {
        "build": "cargo build --release",
        "build:napi": "node scripts/build-napi.mjs",
        "test": "cargo test --release && pnpm --filter @notedge/pandark test:e2e",
        "typecheck": "pnpm --filter @notedge/pandark typecheck",
        "check:npm": "node scripts/check-npm-packages.mjs",
        "homepage:dev": "pnpm --filter @notedge/homepage dev",
        "homepage:build": "pnpm --filter @notedge/homepage build",
        "homepage:check": "pnpm --filter @notedge/homepage check",
        "placeholder": "nifty publish --placeholder --dry-run",
        "placeholder:publish": "nifty publish --placeholder",
        "placeholder:trust": "nifty trust"
    },
    "devDependencies": {
        "@doki-land/nifty": "^0.0.12",
        "@napi-rs/cli": "^3.10.5",
        "@notedge/pandark": "workspace:*"
    }
}
