{
  "case_id": "store.page_tx.half_commit",
  "description": "fetch 后 abort，无 committed 页面",
  "initial": {
    "steps": [
      {
        "op": "begin_run",
        "run_spec": { "seed_url": "https://example.com/" }
      },
      {
        "op": "enqueue",
        "frontier_item": {
          "canonical_request_url": "https://example.com/",
          "depth": 0
        }
      }
    ]
  },
  "steps": [
    { "op": "claim_next", "host_key": "example.com", "worker_id": "w1" },
    { "op": "begin_page_tx", "worker_id": "w1" },
    { "op": "page_tx_put_fetch", "fixture": "sample_response_body.bin" },
    { "op": "abort_page_tx" },
    { "op": "reopen" }
  ],
  "assertions": [
    { "kind": "page_phase", "page_id": "auto", "expected": "claimed" },
    { "kind": "event_count", "min": 0, "max": 0 }
  ]
}
