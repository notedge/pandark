{
    "name": "@notedge/homepage",
    "version": "0.0.3",
    "private": true,
    "type": "module",
    "description": "Pandark marketing homepage (VMZ static site with @notedge/pandark probe)",
    "scripts": {
        "check": "node ../../../scripts/ensure-vmz-host-manifest.mjs && vmz check .",
        "build": "node ../../../scripts/ensure-vmz-host-manifest.mjs && vmz build --release --profile static .",
        "dev": "node ../../../scripts/ensure-vmz-host-manifest.mjs && vmz dev .",
        "preview": "vmz serve --profile static .",
        "test:pandark": "pnpm --filter @notedge/pandark test:e2e"
    },
    "dependencies": {
        "@notedge/pandark": "workspace:*",
        "@vmz/core": "0.3.12",
        "@vmz/ui": "0.3.12",
        "@vmz/ui-icons": "0.3.12"
    },
    "devDependencies": {
        "@vmz/plugin": "0.3.12",
        "@vmz/vmz": "0.3.12"
    }
}
